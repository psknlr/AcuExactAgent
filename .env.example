# Set environment variables in your shell or container; this file is not auto-loaded.
# Offline demo does not call an API. PDF agent and connection tests do.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
# Custom OpenAI-compatible endpoints require an explicit key in the web form,
# or --api-key-env CUSTOM_API_KEY on the CLI (never inherited from OPENAI_API_KEY).
CUSTOM_API_KEY=
